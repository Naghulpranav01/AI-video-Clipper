# ── Model providers ────────────────────────────────────────────────────────────
# Default provider for moment picking: groq | openai | gemini | ollama
# The web UI's "Models & Keys" tab can override all of this per job.
LLM_PROVIDER=groq
ASR_PROVIDER=groq

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_ASR_MODEL=whisper-large-v3-turbo

# OpenAI or any OpenAI-compatible API (OpenRouter, Together, DeepSeek, LM Studio, vLLM...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_ASR_MODEL=whisper-1

# Google Gemini (free tier at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local LLM through Ollama (or point OPENAI_BASE_URL at LM Studio)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Local ASR through faster-whisper (fully offline, CPU): tiny | base | small | medium
LOCAL_WHISPER_MODEL=base

# ── Transcription ──────────────────────────────────────────────────────────────
# ASR_LANGUAGE=en            # leave empty to auto-detect
ASR_CHUNK_SECONDS=600        # 10 min chunks stay far under cloud upload limits
ASR_CONCURRENCY=3            # parallel chunks; local ASR always runs one at a time

# Moment picking
LLM_CHAR_BUDGET=18000        # transcript characters per LLM window

# ── Render ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
MAX_SOURCE_HEIGHT=1080
TEMPLATE=bold-pop            # bold-pop | clean-white | karaoke-green | beast | minimal | news-box
RENDER_QUALITY=standard      # standard (1080p) | turbo (720p ultrafast)
RENDER_CONCURRENCY=2         # clips rendered in parallel
HOOK_SECONDS=3.6

# Optional: auto-publishing through Upload-Post (https://app.upload-post.com)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# ── Web server / remote UI ─────────────────────────────────────────────────────
# Browser origins allowed to call this API. Empty = disabled (same-origin only).
# Enable only when the UI is hosted separately (e.g. on Vercel):
# ALLOW_ORIGINS=*                       # any origin (quick tests)
# ALLOW_ORIGINS=https://my-clipper.vercel.app
ALLOW_ORIGINS=
# Public HTTPS URL of this server, when you expose it for a hosted UI
PUBLIC_URL=
